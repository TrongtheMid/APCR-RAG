# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG — HỆ THỐNG TƯ VẤN THỦ TỤC HÀNH CHÍNH & TỐ TỤNG HÌNH SỰ
# Học phần: INT 3507 2 | Nhóm 9: Phạm Đức Trọng, Vũ Gia Anh Đức, Nguyễn Hữu Hải Long
# ==============================================================================

# API Key cho Google Gemini (dùng cho Query Rewriting, Consultant IRAC, Judge Layer 2)
# Nếu để trống, hệ thống tự động chuyển sang chế độ Deterministic/Template Fallback để demo offline
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Tên mô hình LLM mặc định
GEMINI_MODEL=gemini-1.5-flash

# Cấu hình Vector Database (ChromaDB) & Embedding Model
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=legal_procedures_bge_m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
USE_LIGHTWEIGHT_EMBEDDING=true

# Cấu hình Hybrid Search & Ngưỡng An toàn (Deterministic Refusal)
BM25_WEIGHT=0.6
VECTOR_WEIGHT=0.4
MIN_RETRIEVAL_SCORE=0.18
MAX_REVISION_LOOPS=2
