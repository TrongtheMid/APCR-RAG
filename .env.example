# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG — HỆ THỐNG APCR-RAG (ADMINISTRATIVE & PENAL CRIMINAL RAG)
# Học phần: INT 3507 2 | Nhóm 9: Phạm Đức Trọng, Vũ Gia Anh Đức, Nguyễn Hữu Hải Long
# ==============================================================================

# Lựa chọn nhà cung cấp LLM dùng chung cho Consultant, Baseline và Judge:
# - auto   : Ưu tiên Gemini nếu có GOOGLE_API_KEY hợp lệ; nếu OLLAMA_ENABLED=true thì dùng Ollama cục bộ; ngược lại fallback offline
# - gemini : Chỉ dùng Google Gemini
# - ollama : Chỉ dùng Ollama cục bộ (Qwen2.5 / Vistral)
# - none   : Ép chạy chế độ Deterministic/Template Fallback offline
LLM_PROVIDER=auto

# API Key cho Google Gemini (dùng cho Query Rewriting, Consultant IRAC, Judge Layer 2, Baseline)
# Nếu để trống, hệ thống tự động chuyển sang chế độ Deterministic/Template Fallback để demo offline
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Tên mô hình Gemini mặc định
GEMINI_MODEL=gemini-3.5-flash-lite

# Cấu hình Local LLM qua Ollama (khuyến nghị: qwen2.5:7b hoặc vistral)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cấu hình Vector Database (ChromaDB) & Embedding Model
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=legal_procedures_bge_m3
EMBEDDING_MODEL_NAME=BAAI/bge-m3
USE_LIGHTWEIGHT_EMBEDDING=true

# Cấu hình Hybrid Search & Ngưỡng An toàn (Deterministic Refusal)
BM25_WEIGHT=0.6
VECTOR_WEIGHT=0.4
MIN_RETRIEVAL_SCORE=0.18
MAX_REVISION_LOOPS=2
